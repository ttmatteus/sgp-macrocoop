# usada só no server (server actions/proxy), o browser nunca chama a api direto.
# obrigatoria: em dev local aponta pra api local, em prod (vercel) pra url do cloud run
API_URL=http://localhost:3000/api

# so pro server (getSessionUser/layout), controla quem ve os paineis de dev
# preview (dashboard, limpar turno de teste). vazio = ninguem
DEV_PREVIEW_LOGIN=

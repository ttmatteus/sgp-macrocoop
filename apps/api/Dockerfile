# This file is generated by Nx.
# Build the docker image with `npx nx docker:build @org/api`.
# Tip: Modify "docker:build" options in project.json to change docker build args.
#
# Run the container with `nx docker:run @org/api -p 3000:3000`.
#
FROM docker.io/node:lts-alpine

ENV HOST=0.0.0.0
ENV PORT=3000

RUN corepack enable


WORKDIR /app

COPY dist .

# argon2 and prisma need their install-time build scripts (native binding /
# engine download) to run; pnpm v10+ blocks these by default unless allowed.
RUN printf 'packages:\n  - "."\nallowBuilds:\n  "@prisma/engines": true\n  argon2: true\n  prisma: true\n' > pnpm-workspace.yaml

# You can remove this install step if you build with `--bundle` option.
# The bundled output will include external dependencies.

RUN pnpm install

CMD [ "node", "main.js" ]

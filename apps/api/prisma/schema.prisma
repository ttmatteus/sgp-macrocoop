generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cooperativa {
  id                  Int                   @id @default(autoincrement())
  codigo              String                @unique @db.VarChar(50)
  nome                String                @db.VarChar(255)
  tipo_cooperativa    String                @db.VarChar(50)
  logo                String?
  contrato            contrato[]
  folha_producao      folha_producao[]
  vinculo_cooperativa vinculo_cooperativa[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pessoa {
  id                  Int                   @id @default(autoincrement())
  cpf                 String                @unique @db.VarChar(14)
  nome                String                @db.VarChar(255)
  data_nascimento     DateTime              @db.Date
  rg                  String?               @db.VarChar(20)
  nome_social         String?               @db.VarChar(255)
  email               String?               @unique @db.VarChar(255)
  vinculo_cooperativa vinculo_cooperativa[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vinculo_cooperativa {
  id                          Int              @id @default(autoincrement())
  pessoa_id                   Int
  cooperativa_id              Int
  matricula                   String           @unique @db.VarChar(20)
  login                       String           @unique @db.VarChar(100)
  senha_hash                  String
  status                      String           @default("ativo") @db.VarChar(20)
  data_admissao               DateTime         @db.Date
  data_desligamento           DateTime?        @db.Date
  coordenador                 Boolean          @default(false)
  token_redefinicao           String?
  token_redefinicao_expira_em DateTime?        @db.Timestamptz(6)
  alocacao                    alocacao[]
  folha_producao              folha_producao[]
  registro_ponto              registro_ponto[]
  turno                       turno?
  cooperativa                 cooperativa      @relation(fields: [cooperativa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pessoa                      pessoa           @relation(fields: [pessoa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([login], map: "idx_vinculo_login")
  @@index([matricula], map: "idx_vinculo_matricula")
  @@index([token_redefinicao], map: "idx_vinculo_token_redefinicao")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model folha_producao {
  id                     Int                 @id @default(autoincrement())
  vinculo_cooperativa_id Int
  cooperativa_id         Int
  ano                    Int                 @db.SmallInt
  mes                    Int                 @db.SmallInt
  producao_base          Decimal             @db.Decimal(10, 2)
  rsr                    Decimal             @db.Decimal(10, 2)
  rsr_percentual         Decimal             @db.Decimal(7, 6)
  adicionais             Decimal             @default(0) @db.Decimal(10, 2)
  inss_desconto          Decimal             @db.Decimal(10, 2)
  irrf_desconto          Decimal             @db.Decimal(10, 2)
  total                  Decimal             @db.Decimal(10, 2)
  mensagens              Json?
  fechada_em             DateTime            @default(now()) @db.Timestamptz(6)
  cooperativa            cooperativa         @relation(fields: [cooperativa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vinculo_cooperativa    vinculo_cooperativa @relation(fields: [vinculo_cooperativa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vinculo_cooperativa_id, ano, mes], map: "folha_producao_competencia_unica")
  @@index([cooperativa_id, ano, mes], map: "folha_producao_cooperativa_competencia_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model faixa_inss {
  id              Int       @id @default(autoincrement())
  valor_minimo    Decimal   @db.Decimal(10, 2)
  valor_maximo    Decimal?  @db.Decimal(10, 2)
  aliquota        Decimal   @db.Decimal(5, 4)
  parcela_deduzir Decimal   @default(0) @db.Decimal(10, 2)
  vigencia_inicio DateTime  @db.Date
  vigencia_fim    DateTime? @db.Date

  @@unique([vigencia_inicio, valor_minimo], map: "faixa_inss_unica")
  @@index([vigencia_inicio], map: "faixa_inss_vigencia_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model faixa_irrf {
  id              Int       @id @default(autoincrement())
  valor_minimo    Decimal   @db.Decimal(10, 2)
  valor_maximo    Decimal?  @db.Decimal(10, 2)
  aliquota        Decimal   @db.Decimal(5, 4)
  deducao         Decimal   @default(0) @db.Decimal(10, 2)
  vigencia_inicio DateTime  @db.Date
  vigencia_fim    DateTime? @db.Date

  @@unique([vigencia_inicio, valor_minimo], map: "faixa_irrf_unica")
  @@index([vigencia_inicio], map: "faixa_irrf_vigencia_idx")
